  "gpu_mem_gres": false,
  "gpu_sbatch_args": [],
  "mail_domain": "unil.ch",
  "presets": {
    "medium-gpu": {
      "cpus": 4,
      "mem_per_cpu": "8G",
      "gpu": true
    }
  }
}
