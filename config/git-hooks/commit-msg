#!/usr/bin/env bash
# Appends a Co-Authored-By trailer identifying the AI agent that made the commit, unless the
# agent already added one itself. Claude Code adds its own trailer, naming the model it
# actually ran, so for Claude this usually does nothing; Codex adds none.
# Reads AGENT and AGENT_MODEL from the container environment (set by hpc-agent-run).
# AGENT_MODEL is set only for headless runs, where --model decides the model; in interactive
# and Remote Control sessions the model is picked in the session, so it is left out.
set -euo pipefail

COMMIT_MSG_FILE="$1"
AGENT="${AGENT:-unknown}"
MODEL="${AGENT_MODEL:-}"

case "$AGENT" in
    claude) AUTHOR="Claude";  EMAIL="noreply@anthropic.com" ;;
    codex)  AUTHOR="Codex";   EMAIL="noreply@openai.com"    ;;
    *)      AUTHOR="$AGENT";  EMAIL="noreply@hpc-agents"  ;;
esac


TRAILER="Co-Authored-By: ${AUTHOR} (${MODEL}) <${EMAIL}>"

# Skip if a co-author from this agent's vendor is already there: Claude Code adds its own
# trailer naming the model that actually ran (AGENT_MODEL is only the launch default).
# Also makes the hook idempotent.
grep -qiE "^Co-Authored-By:.*<${EMAIL}>" "$COMMIT_MSG_FILE" && exit 0

# Git trailer convention: ensure a blank line before the trailer block
if [[ -n "$(tail -1 "$COMMIT_MSG_FILE")" ]]; then
    echo "" >> "$COMMIT_MSG_FILE"
fi

echo "$TRAILER" >> "$COMMIT_MSG_FILE"
