#!/usr/bin/env bash
# Host-side launcher: resolves config, sets up workspace and tmpdir, fires Singularity.
# Called by slurm/run-agent.sh (inside a SLURM job) or directly for interactive use.
#
# Usage: euler-agent-run [--agent codex|claude] [--task "prompt"] [--task-file FILE]
#                        [--repo URL] [--model MODEL] [--project NAME] [--interactive]
#                        [--max-budget-usd N] [--effort low|medium|high|xhigh|max]
set -euo pipefail

usage() {
    cat <<'EOF'
euler-agent-run — set up workspace and launch an agent inside the Singularity container

USAGE
  euler-agent-run [OPTIONS]

Called automatically by SLURM via slurm/run-agent.sh. You can also invoke it
directly on a compute node (e.g. after euler-agent-submit --interactive).

OPTIONS
  --agent  codex|claude       Agent to run (default: codex)
  --task   "PROMPT"           Task description
  --task-file FILE            Read task from a file instead of --task
  --repo   URL                Git repo to clone into the workspace before running (public only:
                              the container holds no git credentials)
  --model  MODEL              Model override (e.g. claude-sonnet-4-6, gpt-5.4)
  --project NAME              Named workspace; persists and is reused across jobs.
                              Without --project, a fresh timestamped dir is created.
  --max-budget-usd N          Hard USD spending cap (Claude only)
  --effort low|medium|high|xhigh|max
                              Thinking depth (Claude only)
  --auth   login|subscription|apikey
                              Claude auth source (default: login). Ignored for Codex.
                              'login'        uses the claude.ai login stored in home-claude/ by
                                             --claude-login. Nothing is injected; the stored
                                             credential refreshes itself. Same credential
                                             Remote Control needs, so one login covers everything.
                              'subscription' injects CLAUDE_CODE_OAUTH_TOKEN, a long-lived token
                                             from 'claude setup-token' (notional cost, plan rate
                                             limits apply). Does not work with --remote-control.
                              'apikey'       injects ANTHROPIC_API_KEY (pay-per-use, accurate cost
                                             reporting). Does not work with --remote-control.
  --ref DIR                   Bind a reference directory READ-ONLY at its own host path
  --extra-bind SPEC           Bind an extra host path READ-WRITE into the container. Repeatable.
                              SPEC is SRC[:DEST][:ro|rw]. DEST defaults to SRC — the same path
                              inside and outside — which is what you want: code the agent writes
                              then runs unchanged on the host. Give a DEST only when you must.
                              It must be absolute (that distinguishes SRC:DEST from SRC:MODE).
  --extra-read-bind SPEC      Same, but READ-ONLY. Repeatable. Passing an explicit ':rw' here
                              is an error rather than a silent downgrade.
  --binds-file FILE           Read binds from FILE, one SPEC per line (same syntax; mode defaults
                              to ro; '#' starts a comment). Relative SRC paths resolve against
                              the file's directory, so a repo can ship its own file with '.:rw'.
                              Repeatable. An --extra-bind for the same destination wins.
  --interactive               Open an interactive shell inside the container instead of running
  --claude-login              One-time: run 'claude auth login' with home-claude/ writable to
                              obtain the full-scope OAuth login Remote Control requires. Run this
                              directly on a login node (needs a TTY + internet); no SLURM.
  --remote-control            Start a steerable Claude session (drive it from claude.ai/code or the
                              mobile app) instead of running a task headless. Claude-only; requires
                              --project (transcripts persist in the project home). Model is chosen
                              per-session in the app; --model/--effort/--max-budget-usd/--auth
                              do not apply (it runs on the stored OAuth login).
                              Combine with --interactive to get a container shell instead of
                              starting the session immediately, then run 'claude-rc' yourself.
  -h, --help                  Show this help

Task resolution order (highest priority first):
  1. --task flag
  2. --task-file flag
  3. config/task.json (also pulls model, effort, budget, repo_url, project from there)
  4. Agent defaults in config/settings.json

EXAMPLES
  # Run claude on a task (on a compute node or in an existing SLURM job)
  euler-agent-run --agent claude --task "Write unit tests for src/utils.py" \
      --project myproject --max-budget-usd 5

  # Interactive shell inside the Singularity container
  euler-agent-run --agent codex --project myproject --interactive

  # Provide a reference dataset inside the container (read-only, same path as on the host)
  euler-agent-run --agent claude --project myproject \
      --ref /cluster/project/beltrao/shared/data \
      --task "Analyse the CSV files in /cluster/project/beltrao/shared/data and write a summary."

PATHS INSIDE THE CONTAINER
  Every bound directory appears at its host path: the workspace, this repo (read-only), --ref,
  --extra-bind, and the host conda/pixi/cache dirs from settings. Only the agent's home differs:
  it is /home, a per-job copy of home-<agent>/ (persistent under <workspace>/.claude-home with
  --remote-control). The host home is never mounted, so nothing the agent does lands under ~.

CONFIGURATION
  config/settings.json   Image path, workspace dir, host tool dirs, git identity, per-agent
                         model/budget defaults. Override in config/settings.local.json.
  config/task.json       Default task used when no --task / --task-file given
  config/secrets.env     API keys (gitignored, sourced automatically)
EOF
}

SCRIPT_PATH=$(realpath "$0")
REPO_DIR=$(dirname "$(dirname "$SCRIPT_PATH")")
SETTINGS="$REPO_DIR/config/settings.json"

SETTINGS_LOCAL="$REPO_DIR/config/settings.local.json"
if [[ -f "$SETTINGS_LOCAL" ]]; then
    _TMP=$(mktemp)
    python3 -c "
import json
s = json.load(open('$SETTINGS'))
s.update(json.load(open('$SETTINGS_LOCAL')))
json.dump(s, open('$_TMP', 'w'))
"
    SETTINGS="$_TMP"
fi

_setting() {
    python3 -c "import json; s=json.load(open('$SETTINGS')); print($1)"
}

WORKSPACE_DIR=$(_setting "s['workspace_dir']")
IMAGE_PATH=$(_setting "s['image_path']")
LOGS_DIR=$(_setting "s.get('logs_dir', s['workspace_dir'] + '/logs')")

# Host tool directories, bound at their own paths so environments and caches are shared
# with the host and nothing accumulates under the quota-limited home. All optional (null).
HOST_CONDA_ENVS_DIR=$(_setting "s.get('conda_envs_dir') or ''")
HOST_CONDA_PKGS_DIR=$(_setting "s.get('conda_pkgs_dir') or ''")
HOST_PIXI_HOME=$(_setting "s.get('pixi_home') or ''")
HOST_CACHE_DIR=$(_setting "s.get('cache_dir') or ''")
# Commit identity for the agent. An identity, not a credential: no push token exists in
# the container; the user pushes from the host after the run.
GIT_USER_NAME=$(_setting "s.get('git_user_name') or 'euler-agent'")
GIT_USER_EMAIL=$(_setting "s.get('git_user_email') or 'euler-agent@noreply.invalid'")

# Parse args
AGENT="codex"
TASK=""
TASK_FILE=""
REPO_URL=""
MODEL=""
MAX_BUDGET_USD=""
AGENT_EFFORT=""
AUTH_MODE=""
PROJECT=""
REF_DIR=""
EXTRA_BINDS=()
EXTRA_READ_BINDS=()
BIND_FILES=()
INTERACTIVE=false
GPU=false
NOTIFY_SUCCESS_OVERRIDE=""
REMOTE_CONTROL=false
CLAUDE_LOGIN=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)           usage; exit 0 ;;
        --agent)             AGENT="$2";               shift 2 ;;
        --task)              TASK="$2";                shift 2 ;;
        --task-file)         TASK_FILE="$2";           shift 2 ;;
        --repo)              REPO_URL="$2";            shift 2 ;;
        --model)             MODEL="$2";               shift 2 ;;
        --max-budget-usd)    MAX_BUDGET_USD="$2";      shift 2 ;;
        --effort)            AGENT_EFFORT="$2";        shift 2 ;;
        --auth)              AUTH_MODE="$2";           shift 2 ;;
        --project)           PROJECT="$2";             shift 2 ;;
        --ref)               REF_DIR="$2";             shift 2 ;;
        --extra-bind)        EXTRA_BINDS+=("$2");      shift 2 ;;
        --extra-read-bind)   EXTRA_READ_BINDS+=("$2"); shift 2 ;;
        --binds-file)        BIND_FILES+=("$2");       shift 2 ;;
        --remote-control)    REMOTE_CONTROL=true;      shift ;;
        --claude-login)      CLAUDE_LOGIN=true;        shift ;;
        --gpu)               GPU=true;                 shift ;;
        --gpu-type)          shift 2 ;;  # consumed by euler-agent-submit, ignored here
        --interactive)       INTERACTIVE=true;         shift ;;
        --notify-success)    NOTIFY_SUCCESS_OVERRIDE="true";  shift ;;
        --no-notify-success) NOTIFY_SUCCESS_OVERRIDE="false"; shift ;;
        *) echo "Unknown argument: $1" >&2; echo "Run with --help for usage." >&2; exit 1 ;;
    esac
done

# One-time interactive OAuth login for Claude Remote Control.
# Remote Control requires a full-scope claude.ai login token (API keys and the
# inference-only `claude setup-token` are both rejected). We run `claude auth login`
# with home-claude/ bound WRITABLE so the resulting credentials persist there and
# later seed each project's persistent Remote Control home.
# Run this directly on a login node (has internet); it needs a TTY for the browser flow.
if [[ "$CLAUDE_LOGIN" == true ]]; then
    SOURCE_HOME="$REPO_DIR/home-claude"
    mkdir -p "$SOURCE_HOME"
    echo "Launching 'claude auth login' inside the container."
    echo "  Credentials persist in: $SOURCE_HOME  (gitignored)"
    echo "  Choose your claude.ai account (NOT an API key) when prompted."
    singularity exec \
        --cleanenv --containall \
        --home "$SOURCE_HOME:/home" \
        --env "PATH=/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        "$IMAGE_PATH" \
        bash -lc 'export HOME=/home; cd /home; claude auth login && echo && claude auth status'
    echo "If login succeeded, launch a steerable session with:"
    echo "  euler-agent-submit --agent claude --remote-control --project NAME --time 8:00:00"
    exit 0
fi

# Helper: read a field from settings.json scoped to the current agent.
# Each agent only reads its own section — codex and claude never share defaults.
_agent_setting() {
    python3 -c "
import json, sys
s = json.load(open('${SETTINGS}'))
val = s.get('${AGENT}', {}).get(sys.argv[1])
print('' if val is None else val)
" "$1"
}

# Resolve task: --task > --task-file > config/task.json.
# When reading task.json, also pull per-task overrides for model/effort/budget
# (CLI flags above take highest priority and are already set).
if [[ -n "$TASK" ]]; then
    : # already set by --task flag
elif [[ -n "$TASK_FILE" ]]; then
    TASK=$(cat "$TASK_FILE")
else
    _tj() {
        python3 -c "
import json, sys
t = json.load(open('${REPO_DIR}/config/task.json'))
val = t.get(sys.argv[1])
print('' if val is None else val)
" "$1"
    }
    TASK=$(_tj task)
    [[ -z "$REPO_URL"       ]] && REPO_URL=$(_tj repo_url)
    [[ -z "$PROJECT"        ]] && PROJECT=$(_tj project)
    [[ -z "$MODEL"          ]] && MODEL=$(_tj model)
    [[ -z "$MAX_BUDGET_USD" ]] && MAX_BUDGET_USD=$(_tj max_budget_usd)
    [[ -z "$AGENT_EFFORT"   ]] && AGENT_EFFORT=$(_tj effort)
fi

# Fill any remaining blanks from agent-specific settings.json defaults.
[[ -z "$MODEL"          ]] && MODEL=$(_agent_setting model)
[[ -z "$MAX_BUDGET_USD" ]] && MAX_BUDGET_USD=$(_agent_setting max_budget_usd)
[[ -z "$AGENT_EFFORT"   ]] && AGENT_EFFORT=$(_agent_setting effort)
[[ -z "$AUTH_MODE"      ]] && AUTH_MODE=$(_agent_setting auth)
[[ -z "$AUTH_MODE"      ]] && AUTH_MODE="login"

# Remote Control mode: a long-running, steerable Claude session (claude.ai/mobile app).
# Distinct from the headless one-shot path — requires a persistent, project-scoped home
# so the conversation transcripts survive the job (stored under .claude-home).
if [[ "$REMOTE_CONTROL" == true ]]; then
    [[ "$AGENT" == claude ]] || { echo "ERROR: --remote-control is claude-only." >&2; exit 1; }
    [[ -n "$PROJECT"      ]] || { echo "ERROR: --remote-control requires --project (session transcript persists in the project home)." >&2; exit 1; }
fi

# Load API credentials (secrets.env is the template; secrets.local.env holds real values)
SECRETS="$REPO_DIR/config/secrets.env"
[[ -f "$SECRETS" ]] && source "$SECRETS"
SECRETS_LOCAL="$REPO_DIR/config/secrets.local.env"
[[ -f "$SECRETS_LOCAL" ]] && source "$SECRETS_LOCAL"
OPENAI_API_KEY="${OPENAI_API_KEY:-}"
ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}"

# Resolve workspace: named project (persistent, reused) or timestamped (one-off)
if [[ -n "$PROJECT" ]]; then
    RUN_WORKSPACE="$WORKSPACE_DIR/$PROJECT"
else
    RUN_WORKSPACE="$WORKSPACE_DIR/${AGENT}_$(date +%Y%m%d_%H%M%S)_${SLURM_JOB_ID:-interactive}"
fi
mkdir -p "$RUN_WORKSPACE"

# Set up job-scoped tmpdir (becomes /tmp inside the container)
JOB_TMPDIR="${TMPDIR:-/tmp}/euler-agents.${SLURM_JOB_ID:-$$}"
mkdir -p "$JOB_TMPDIR/scratch"

# Write task to job-specific scratch (not workspace) to avoid races on parallel jobs
printf '%s' "$TASK" > "$JOB_TMPDIR/scratch/.task"

# Give each job its own home copy so parallel jobs don't race on agent cache/state.
# Remote Control is the exception: it uses a persistent, project-scoped home so the
# OAuth token refreshes and the conversation transcript survive across jobs.
SOURCE_HOME="$REPO_DIR/home-${AGENT}"
mkdir -p "$SOURCE_HOME"
if [[ "$REMOTE_CONTROL" == true ]]; then
    JOB_HOME="$RUN_WORKSPACE/.claude-home"
    if [[ ! -d "$JOB_HOME" ]]; then
        echo "Seeding persistent Claude home at $JOB_HOME from $SOURCE_HOME"
        cp -r "$SOURCE_HOME" "$JOB_HOME"
    else
        echo "Reusing persistent Claude home at $JOB_HOME (session transcripts live here)"
        # A newer login in home-claude/ (from --claude-login, e.g. after switching
        # accounts) supersedes the one stored here, so one login covers every project.
        # Only the claude.ai credential and account are replaced; MCP authorisations in
        # the same file are kept. Skipped when this home's credential is newer — it
        # refreshes itself during sessions and must not be rolled back.
        _src_cred="$SOURCE_HOME/.claude/.credentials.json"
        _dst_cred="$JOB_HOME/.claude/.credentials.json"
        if [[ -f "$_src_cred" && ( ! -f "$_dst_cred" || "$_src_cred" -nt "$_dst_cred" ) ]]; then
            python3 - "$SOURCE_HOME" "$JOB_HOME" <<'PY'
import json, os, sys
src, dst = sys.argv[1], sys.argv[2]
def load(p):
    return json.load(open(p)) if os.path.exists(p) else {}
s_cred, d_cred = load(f"{src}/.claude/.credentials.json"), load(f"{dst}/.claude/.credentials.json")
if "claudeAiOauth" in s_cred:
    d_cred["claudeAiOauth"] = s_cred["claudeAiOauth"]
    os.makedirs(f"{dst}/.claude", exist_ok=True)
    with open(f"{dst}/.claude/.credentials.json", "w") as f:
        json.dump(d_cred, f)
    os.chmod(f"{dst}/.claude/.credentials.json", 0o600)
s_cfg, d_cfg = load(f"{src}/.claude.json"), load(f"{dst}/.claude.json")
if "oauthAccount" in s_cfg:
    d_cfg["oauthAccount"] = s_cfg["oauthAccount"]
    with open(f"{dst}/.claude.json", "w") as f:
        json.dump(d_cfg, f)
PY
            echo "Login:     refreshed from $SOURCE_HOME (newer claude.ai login)"
        fi
    fi
else
    JOB_HOME="$JOB_TMPDIR/home-${AGENT}"
    cp -r "$SOURCE_HOME" "$JOB_HOME"
fi

# home-claude/.claude/CLAUDE.md is a symlink to the user's global ~/.claude/CLAUDE.md so the
# agent inherits the same rules. The host home is never bound, so inside the container the
# link would dangle and the rules would silently not load. Materialise it: copy the target
# over the link on every launch — also into the persistent Remote Control home, so edits to
# the global file propagate.
_src_claude_md="$SOURCE_HOME/.claude/CLAUDE.md"
if [[ -L "$_src_claude_md" ]]; then
    _claude_md_target=$(readlink -f "$_src_claude_md")
    if [[ -f "$_claude_md_target" ]]; then
        mkdir -p "$JOB_HOME/.claude"
        rm -f "$JOB_HOME/.claude/CLAUDE.md"
        cp "$_claude_md_target" "$JOB_HOME/.claude/CLAUDE.md"
    else
        echo "WARNING: $_src_claude_md -> $_claude_md_target is missing; agent runs without a global CLAUDE.md" >&2
    fi
fi

echo "Workspace: $RUN_WORKSPACE  (same path inside the container)"
echo "Agent:     $AGENT"
echo "Image:     $IMAGE_PATH"

# Build --env args for singularity
SING_ENV=(
    --env "AGENT=$AGENT"
    --env "REPO_URL=${REPO_URL:-}"
    --env "AGENT_MODEL=${MODEL:-}"
    --env "AGENT_MAX_BUDGET_USD=${MAX_BUDGET_USD:-}"
    --env "AGENT_EFFORT=${AGENT_EFFORT:-}"
    --env "EULER_AGENTS_DIR=$REPO_DIR"
    --env "AGENT_WORKSPACE=$RUN_WORKSPACE"
    --env "GIT_USER_NAME=$GIT_USER_NAME"
    --env "GIT_USER_EMAIL=$GIT_USER_EMAIL"
    # New envs go to the project workspace; the host's envs (if configured) are visible
    # read-only; the image's own envs come last.
    --env "CONDA_ENVS_DIRS=$RUN_WORKSPACE/conda_envs${HOST_CONDA_ENVS_DIR:+:$HOST_CONDA_ENVS_DIR}:/opt/conda/envs"
    --env "CONDA_PKGS_DIRS=${HOST_CONDA_PKGS_DIR:-/tmp/conda_pkgs}"
)
# Keep caches off the (quota-limited, unmounted anyway) home: XDG_CACHE_HOME covers pip,
# uv, torch and Hugging Face (HF_HOME defaults to $XDG_CACHE_HOME/huggingface);
# CUDA's JIT cache (~/.nv) has its own variable.
if [[ -n "$HOST_CACHE_DIR" ]]; then
    mkdir -p "$HOST_CACHE_DIR"
    SING_ENV+=(
        --env "XDG_CACHE_HOME=$HOST_CACHE_DIR"
        --env "CUDA_CACHE_PATH=$HOST_CACHE_DIR/nv"
    )
fi
# pixi: the host's static binary and global config (which redirects envs + cache) are
# reached through the PIXI_HOME bind below; bin/container-env.sh puts it on PATH.
[[ -n "$HOST_PIXI_HOME" ]] && SING_ENV+=(--env "PIXI_HOME=$HOST_PIXI_HOME")
[[ -n "$OPENAI_API_KEY" ]]   && SING_ENV+=(--env "OPENAI_API_KEY=$OPENAI_API_KEY")

# Anthropic auth (Claude only). Two modes; each withholds the other's credential
# (--containall --cleanenv keeps any host credential out, so not injecting is enough):
#   subscription — inject CLAUDE_CODE_OAUTH_TOKEN, a long-lived `claude setup-token`.
#                  Cost reporting is notional; bound by plan rate limits.
#   apikey       — inject ANTHROPIC_API_KEY (pay-per-use, accurate cost reporting).
if [[ "$REMOTE_CONTROL" == true ]]; then
    # Inject no credential: Remote Control uses the full-scope OAuth login stored in
    # the persistent home (from `euler-agent-run --claude-login`). An injected
    # ANTHROPIC_API_KEY or inference-only token would be rejected by Remote Control.
    if [[ ! -f "$JOB_HOME/.claude/.credentials.json" ]]; then
        echo "WARNING: no OAuth credentials found in $JOB_HOME/.claude/.credentials.json." >&2
        echo "         Remote Control will fail to start. Run 'euler-agent-run --claude-login' first," >&2
        echo "         then delete $JOB_HOME so it re-seeds from the fresh login." >&2
    fi
    echo "Auth:      Claude subscription (full-scope OAuth from persistent home)"
elif [[ "$AGENT" == claude && "$AUTH_MODE" == login ]]; then
    # Use the claude.ai login stored in home-claude/ by --claude-login. It is copied into
    # this run's home like the rest of that directory, and it carries a refresh token, so
    # it renews itself. Inject no credential: an env token would take precedence over the
    # stored login and defeat the point.
    if [[ ! -f "$JOB_HOME/.claude/.credentials.json" ]]; then
        echo "ERROR: --auth login needs a stored claude.ai login, and none was found in" >&2
        echo "       $SOURCE_HOME/.claude/.credentials.json" >&2
        echo "       Run 'bin/euler-agent-run --claude-login' on a login node first." >&2
        exit 1
    fi
    echo "Auth:      Claude subscription (stored claude.ai login)"
elif [[ "$AGENT" == claude && "$AUTH_MODE" == subscription ]]; then
    if [[ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]]; then
        echo "ERROR: --auth subscription requires CLAUDE_CODE_OAUTH_TOKEN in config/secrets.local.env." >&2
        echo "       Generate one with 'claude setup-token'. Use --auth apikey for pay-per-use instead." >&2
        exit 1
    fi
    SING_ENV+=(--env "CLAUDE_CODE_OAUTH_TOKEN=$CLAUDE_CODE_OAUTH_TOKEN")
    echo "Auth:      Claude subscription (long-lived OAuth token)"
elif [[ "$AGENT" == claude && -z "$ANTHROPIC_API_KEY" ]]; then
    echo "ERROR: --auth apikey requires ANTHROPIC_API_KEY in config/secrets.local.env." >&2
    echo "       Use --auth subscription to run on your Claude subscription instead." >&2
    exit 1
else
    [[ -n "$ANTHROPIC_API_KEY" ]] && SING_ENV+=(--env "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY")
    [[ "$AGENT" == claude ]] && echo "Auth:      Anthropic API key"
fi
[[ -n "${SLURM_JOB_ID:-}" ]] && SING_ENV+=(--env "SLURM_JOB_ID=$SLURM_JOB_ID")
if [[ "$REMOTE_CONTROL" == true ]]; then
    SING_ENV+=(
        --env "REMOTE_CONTROL=true"
        --env "RC_SESSION_NAME=euler-rc-${PROJECT}-${SLURM_JOB_ID:-interactive}"
    )
fi

# Identity binds: every host directory appears at its own path inside the container, so
# absolute paths, shebangs and conda prefixes the agent writes are valid on the host too.
# Only /home and /tmp are container-private. The host home itself is never mounted.
SING_BINDS=(
    --home "$JOB_HOME:/home"
    --bind "$RUN_WORKSPACE:$RUN_WORKSPACE"
    --bind "$REPO_DIR:$REPO_DIR:ro"
    --bind "$JOB_TMPDIR/scratch:/tmp"
)
# Every container-side mount destination, so a --binds-file entry can never mount a
# second time over something already bound (the launcher's own binds included).
MOUNTED_DESTS=("$RUN_WORKSPACE" "$REPO_DIR" /home /tmp)
if [[ -n "$REF_DIR" ]]; then
    [[ -e "$REF_DIR" ]] || { echo "ERROR: --ref directory does not exist: $REF_DIR" >&2; exit 1; }
    REF_DIR=$(realpath -- "$REF_DIR")
    SING_BINDS+=(--bind "$REF_DIR:$REF_DIR:ro")
    MOUNTED_DESTS+=("$REF_DIR")
    echo "Reference: $REF_DIR  (read-only)"
fi

# Host tool dirs from settings. Conda envs read-only (usable, not modifiable — pass a
# specific env via --extra-bind to allow installs into it); package cache and pixi home
# read-write (shared caches; pixi's config.toml there redirects its envs and cache).
_host_dir_bind() {  # $1 = host path, $2 = ro|rw, $3 = label for messages
    [[ -n "$1" ]] || return 0
    if [[ ! -d "$1" ]]; then
        echo "WARNING: $3 '$1' does not exist on the host; not bound" >&2
        return 0
    fi
    SING_BINDS+=(--bind "$1:$1:$2")
    MOUNTED_DESTS+=("$1")
    echo "Host $3: $1  ($2)"
}
_host_dir_bind "$HOST_CONDA_ENVS_DIR" ro "conda envs"
_host_dir_bind "$HOST_CONDA_PKGS_DIR" rw "conda pkgs"
_host_dir_bind "$HOST_PIXI_HOME"      rw "pixi home"
_host_dir_bind "$HOST_CACHE_DIR"      rw "cache dir"

# Turn a bind SPEC into a singularity --bind value.
#   SPEC = SRC[:DEST][:ro|rw],  $2 = default mode when SPEC omits one,
#   $3 = "strict" to reject an explicit mode that differs from $2 (--extra-read-bind)
# DEST is required to be absolute, which is what disambiguates SRC:DEST from
# SRC:MODE without guessing. Prints the resolved spec; returns non-zero on a bad
# spec (the caller must check — an `exit` here would only leave the subshell).
_resolve_bind() {
    local spec="$1" want_mode="$2" strict="${3:-}"
    local -a f=()
    IFS=':' read -r -a f <<< "$spec"
    local src="${f[0]}" dest="" mode=""

    case "${#f[@]}" in
        1) ;;
        2) if [[ "${f[1]}" == ro || "${f[1]}" == rw ]]; then mode="${f[1]}"; else dest="${f[1]}"; fi ;;
        3) dest="${f[1]}"; mode="${f[2]}" ;;
        *) echo "ERROR: cannot parse bind spec '$spec' (expected SRC[:DEST][:ro|rw])" >&2; return 1 ;;
    esac

    if [[ ! -e "$src" ]]; then
        echo "ERROR: bind source does not exist: $src" >&2
        return 1
    fi
    src=$(realpath -- "$src")

    if [[ -z "$dest" ]]; then
        dest="$src"
    elif [[ "$dest" != /* ]]; then
        echo "ERROR: bind destination must be absolute, got '$dest' in '$spec'" >&2
        return 1
    fi

    [[ -z "$mode" ]] && mode="$want_mode"
    if [[ "$mode" != ro && "$mode" != rw ]]; then
        echo "ERROR: bind mode must be 'ro' or 'rw', got '$mode' in '$spec'" >&2
        return 1
    fi
    # Refuse to silently downgrade: an explicit :rw on the read-only flag is a
    # contradiction, so say so instead of quietly mounting it read-only.
    if [[ "$strict" == strict && "$want_mode" == ro && "$mode" == rw ]]; then
        echo "ERROR: '$spec' asks for rw but was passed to --extra-read-bind." >&2
        echo "       Use --extra-bind for read-write access." >&2
        return 1
    fi

    printf '%s:%s:%s' "$src" "$dest" "$mode"
}

# Container-side destinations of every extra bind, collected so Remote Control can
# pre-accept workspace trust for each of them (see below).
BIND_DESTS=("$RUN_WORKSPACE")

for _spec in ${EXTRA_BINDS[@]+"${EXTRA_BINDS[@]}"}; do
    _resolved=$(_resolve_bind "$_spec" rw) || exit 1
    SING_BINDS+=(--bind "$_resolved")
    BIND_DESTS+=("$(cut -d: -f2 <<< "$_resolved")")
    MOUNTED_DESTS+=("$(cut -d: -f2 <<< "$_resolved")")
    echo "Extra bind: $_resolved"
done
for _spec in ${EXTRA_READ_BINDS[@]+"${EXTRA_READ_BINDS[@]}"}; do
    _resolved=$(_resolve_bind "$_spec" ro strict) || exit 1
    SING_BINDS+=(--bind "$_resolved")
    BIND_DESTS+=("$(cut -d: -f2 <<< "$_resolved")")
    MOUNTED_DESTS+=("$(cut -d: -f2 <<< "$_resolved")")
    echo "Extra bind: $_resolved"
done

# Binds from --binds-file, after the explicit flags so a flag for the same
# destination wins (e.g. to make a file's read-only entry writable for one run).
# One SPEC per line, '#' comments, blank lines ignored. A relative SRC (including
# '.') is taken relative to the file's directory, so a repository can carry its own
# binds file and declare itself with '.:rw'. A leading '~/' means the host home.
for _file in ${BIND_FILES[@]+"${BIND_FILES[@]}"}; do
    [[ -f "$_file" ]] || { echo "ERROR: --binds-file not found: $_file" >&2; exit 1; }
    _file=$(realpath -- "$_file")
    _base=$(dirname "$_file")
    while IFS= read -r _line || [[ -n "$_line" ]]; do
        _line="${_line%%#*}"
        _line="$(printf '%s' "$_line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
        [[ -n "$_line" ]] || continue
        _src="${_line%%:*}"
        _rest="${_line#"$_src"}"
        case "$_src" in
            /*)  ;;
            '~'|'~/'*) _src="$HOME${_src#\~}" ;;
            *)   _src="$_base/$_src" ;;
        esac
        _resolved=$(_resolve_bind "$_src$_rest" ro) || { echo "       (in $_file)" >&2; exit 1; }
        _dest=$(cut -d: -f2 <<< "$_resolved")
        _dup=false
        for _d in "${MOUNTED_DESTS[@]}"; do [[ "$_d" == "$_dest" ]] && _dup=true; done
        if [[ "$_dup" == true ]]; then
            echo "Binds file: $_dest is already mounted, skipping this entry"
            continue
        fi
        SING_BINDS+=(--bind "$_resolved")
        BIND_DESTS+=("$_dest")
        MOUNTED_DESTS+=("$_dest")
        echo "Binds file: $_resolved"
    done < "$_file"
done

# Per-session briefing for the agent: the generic text from config/agent-briefing.md
# plus the actual mount table of this run. Lands in the job scratch, i.e. at
# /tmp/agent-briefing.md inside the container, where an interactive user can paste it
# or start with `claude "$(cat /tmp/agent-briefing.md)"`.
{
    cat "$REPO_DIR/config/agent-briefing.md"
    printf '\n## Mounts in this session\n\n'
    printf 'Workspace and starting directory: `%s`\n\n' "$RUN_WORKSPACE"
    printf '| Path inside = on the host | Mode |\n|---|---|\n'
    for ((_i = 0; _i < ${#SING_BINDS[@]}; _i++)); do
        [[ "${SING_BINDS[$_i]}" == --bind ]] || continue
        IFS=':' read -r _bsrc _bdest _bmode <<< "${SING_BINDS[$((_i + 1))]}"
        [[ "$_bdest" == /tmp ]] && continue   # container-private scratch, listed below
        printf '| `%s` | %s |\n' "$_bdest" "${_bmode:-rw}"
    done
    printf '| `/home` | rw, private agent home (`~`), not the user'"'"'s home |\n'
    printf '| `/tmp` | rw, node-local scratch, gone after the job |\n'
} > "$JOB_TMPDIR/scratch/agent-briefing.md"

# Claude prompts for per-directory workspace trust the first time it starts in a
# directory (Remote Control has no bypass flag for it at all); trust is keyed by path
# in ~/.claude.json. bin/inner.sh pre-accepts it for the headless path from inside the
# container, but the interactive path never runs inner.sh — and its home is a
# throwaway copy, so the dialog would return every job. Pre-accept here for every
# mode, on the host, where $JOB_HOME is just a directory. Covers the workspace and
# every extra bind destination, since any of those may be the cwd when the session
# starts. Destinations equal host paths, so trust granted here is for the real path.
# The same file records the one-time onboarding (theme + login-method screens); a
# throwaway home would replay it every job, so mark it done too. The
# --dangerously-skip-permissions disclaimer is skipped when either
# ~/.claude.json has bypassPermissionsModeAccepted (older versions) or
# ~/.claude/settings.json has skipDangerousModePermissionPrompt (newer versions
# migrate to this) — set both. These keys are Claude Code internals, not a public API.
python3 - "$JOB_HOME/.claude.json" "$JOB_HOME/.claude/settings.json" "${BIND_DESTS[@]}" <<'PY'
import json, os, sys
cfg, settings, dests = sys.argv[1], sys.argv[2], sys.argv[3:]
d = json.load(open(cfg)) if os.path.exists(cfg) else {}
projects = d.setdefault("projects", {})
for dest in dests:
    projects.setdefault(dest, {})["hasTrustDialogAccepted"] = True
d["hasCompletedOnboarding"] = True
d["bypassPermissionsModeAccepted"] = True
json.dump(d, open(cfg, "w"))
os.makedirs(os.path.dirname(settings), exist_ok=True)
s = json.load(open(settings)) if os.path.exists(settings) else {}
s["skipDangerousModePermissionPrompt"] = True
json.dump(s, open(settings, "w"), indent=2)
PY
echo "Trust:     pre-accepted for ${BIND_DESTS[*]}"

NV_FLAG=()
[[ "$GPU" == true ]] && NV_FLAG=(--nv)

if [[ "$INTERACTIVE" == true ]]; then
    echo "Opening interactive shell inside container..."
    echo "  Workspace: $RUN_WORKSPACE  (same path on the host)"
    [[ "$GPU" == true ]] && echo "  GPU mode enabled (--nv)"
    # `singularity exec bash --rcfile` rather than `singularity shell`, which has
    # no way to load an rcfile: bin/claude-shellrc is what makes the bare `claude`
    # and `codex` commands skip permission prompts, matching bin/inner.sh.
    # The repo is bound at its host path, so the rcfile is addressed by $REPO_DIR.
    singularity exec \
        --cleanenv --containall \
        --pwd "$RUN_WORKSPACE" \
        "${NV_FLAG[@]+"${NV_FLAG[@]}"}" \
        "${SING_ENV[@]}" \
        "${SING_BINDS[@]}" \
        "$IMAGE_PATH" \
        bash --rcfile "$REPO_DIR/bin/claude-shellrc" -i
else
    AGENT_EXIT=0
    singularity exec \
        --cleanenv --containall \
        --pwd "$RUN_WORKSPACE" \
        "${NV_FLAG[@]+"${NV_FLAG[@]}"}" \
        "${SING_ENV[@]}" \
        "${SING_BINDS[@]}" \
        "$IMAGE_PATH" \
        "$REPO_DIR/bin/inner.sh" || AGENT_EXIT=$?

    NOTIFY_EMAIL_ENABLED=$(_setting "str(s.get('notifications', {}).get('email', {}).get('enabled', False)).lower()")
    NOTIFY_EMAIL_ADDRESS=$(_setting "s.get('notifications', {}).get('email', {}).get('address', '')")
    NOTIFY_ON_FAILURE=$(_setting "str(s.get('notifications', {}).get('email', {}).get('on_failure', True)).lower()")
    NOTIFY_ON_SUCCESS_CFG=$(_setting "str(s.get('notifications', {}).get('email', {}).get('on_success', False)).lower()")
    NOTIFY_ON_SUCCESS="${NOTIFY_SUCCESS_OVERRIDE:-$NOTIFY_ON_SUCCESS_CFG}"

    NOTIFY_EMAIL_ENABLED="$NOTIFY_EMAIL_ENABLED" \
    NOTIFY_EMAIL_ADDRESS="$NOTIFY_EMAIL_ADDRESS" \
    NOTIFY_ON_FAILURE="$NOTIFY_ON_FAILURE" \
    NOTIFY_ON_SUCCESS="$NOTIFY_ON_SUCCESS" \
    LOGS_DIR="$LOGS_DIR" \
    "$REPO_DIR/bin/notify.sh" \
        --exit-code "$AGENT_EXIT" \
        --workspace "$RUN_WORKSPACE" \
        --agent "$AGENT" || true

    exit "$AGENT_EXIT"
fi
